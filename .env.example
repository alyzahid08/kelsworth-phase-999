# Copy this file to .env and fill in what you need.
# Only DATABASE_URL, JWT_SECRET, and the ADMIN_INITIAL_* pair are required
# to run the store at all — everything else unlocks an optional feature and
# can be left blank/omitted until you're ready to set it up.

# ---- Required ----
DATABASE_URL=postgresql://user:password@host/dbname
JWT_SECRET=                 # generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=

# ---- General ----
NODE_ENV=development         # set to "production" when deployed
PORT=3000                    # most hosts (Render, Railway) set this for you automatically
SITE_ORIGIN=https://www.kelsworth.com   # used to build absolute links (sitemap, emails, payment return URLs)
PGSSL=                       # set to "true" if your DB host requires SSL and doesn't already default to it (Neon/Supabase do this for you)

# ---- Email (order confirmations, contact form) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
CONTACT_TO_EMAIL=

# ---- WhatsApp (COD order confirmation) ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_CONFIRM_WINDOW_HOURS=

# ---- Gateway payment timeout sweep ----
GATEWAY_PAYMENT_TIMEOUT_HOURS=2

# ---- Stripe (international cards) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_PKR_TO_USD=

# ---- JazzCash (Pakistan) ----
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_HASH_KEY=
JAZZCASH_MODE=sandbox         # "production" when live

# ---- EasyPaisa (Pakistan) ----
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_MODE=sandbox        # "production" when live

# ---- PayFast (Pakistan) ----
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_NAME=
PAYFAST_SECURED_KEY=
PAYFAST_MODE=sandbox          # "production" when live
PAYFAST_SANDBOX_URL=          # optional override; defaults to PayFast's sandbox IPG endpoint
PAYFAST_API_URL=              # optional override; defaults to PayFast's production IPG endpoint
